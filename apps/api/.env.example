# ── Database ───────────────────────────────────────────────────────────────────
# Neon: copy the "pooled" connection string from the Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_ACCESS_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_NAME=E-Tech.
# Must be a verified domain address in Resend
EMAIL_FROM_ADDRESS=hello@deempiretech.com
# Where contact form submissions are delivered
CONTACT_EMAIL=hello@deempiretech.com

# ── File Storage (AWS S3 or S3-compatible, e.g. Cloudflare R2) ─────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Exact origin of the web frontend — no trailing slash
# Comma-separate to allow multiple origins (apex + www)
WEB_URL=https://deempiretech.com,https://www.deempiretech.com

# ── Commerce ───────────────────────────────────────────────────────────────────
# UUID of the organisation that owns the WooCommerce store
COMMERCE_ORG_ID=

# ── WooCommerce ────────────────────────────────────────────────────────────────
WOOCOMMERCE_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate in WooCommerce → Settings → Advanced → Webhooks → Secret
WC_WEBHOOK_SECRET=
