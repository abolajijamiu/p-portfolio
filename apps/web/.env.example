# ── API ────────────────────────────────────────────────────────────────────────
# URL of the Express API — no trailing slash
NEXT_PUBLIC_API_URL=https://api.deempiretech.com

# ── Site ───────────────────────────────────────────────────────────────────────
# Used for OG metadata base URL
NEXT_PUBLIC_SITE_URL=https://deempiretech.com

# ── Media ──────────────────────────────────────────────────────────────────────
# Public base URL for S3/R2 media assets — no trailing slash
# e.g. https://files.deempiretech.com or https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL=
